includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - routes
    tmpDir: storage/framework/phpstan
    ignoreErrors:
        # Opt-in traits (e.g. TenantAware for queued jobs) are not used by any class yet.
        - identifier: trait.unused
